# SkillForge Frontend Environment Variables
# Note: VITE_ variables are bundled with client-side code and are PUBLIC.
# NEVER expose backend secrets, API keys, or database credentials here.

VITE_API_BASE_URL=http://localhost:8000/api/v1

# Real Google OAuth Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=
