# SkillForge Environment Configuration Example
# Copy this file to .env and fill in your values. NEVER commit .env to source control!

# Django Backend Settings
DJANGO_SECRET_KEY=your-secure-random-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database (Supabase)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:your_supabase_password@db.your_project_ref.supabase.co:5432/postgres

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Frontend / CORS
FRONTEND_ORIGIN=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Google OAuth (Phase 1)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: Email (Phase 1)
DEFAULT_FROM_EMAIL=noreply@skillforge.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
